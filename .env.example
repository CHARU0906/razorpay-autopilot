# Razorpay TEST MODE credentials (Priority 1 integration)
# Get test keys from: https://dashboard.razorpay.com/app/keys
# Keys MUST start with rzp_test_ — live-mode keys are rejected by the integration layer.
# Never commit real credentials. This file is safe to commit (example values only).

RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET_HERE

# Optional: webhook secret for signature validation
# Set this to the webhook secret from https://dashboard.razorpay.com/app/webhooks
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET_HERE

# Without these vars, the integration runs in mock fallback mode:
# - send_recovery_link uses MockRecoveryLinkAPI (no real API call)
# - /razorpay/payment/{id} returns 404 with setup instructions
# - /razorpay/status reports live_api_enabled: false
# The benchmark, simulator, and UI all work without any credentials.
